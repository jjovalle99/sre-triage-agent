# Anthropic (Claude Agent SDK)
ANTHROPIC_API_KEY=

# Mistral (Moderation, Classification, Voxtral)
MISTRAL_API_KEY=

# Linear (Ticketing — free tier, https://linear.app)
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# Slack (Notifications — incoming webhook URL)
SLACK_WEBHOOK_URL=

# Resend (Email — free tier, https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=incidents@yourdomain.com

# On-call engineer name (shown in tickets and notifications)
ON_CALL_ENGINEER=On-Call Engineer

# Cloudflare Tunnel (optional, for webhook ingress in Docker)
# Linear Webhook (HMAC-SHA256 secret, from Linear webhook settings)
LINEAR_WEBHOOK_SECRET=

# Cloudflare Tunnel (not needed for quick tunnel — used only for named tunnels)
# CLOUDFLARE_TUNNEL_TOKEN=
